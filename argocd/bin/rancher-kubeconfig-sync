#!/usr/bin/env bash
set -euo pipefail

main() {

RANCHER_URL="${RANCHER_URL:-}"
RANCHER_INSECURE="${RANCHER_INSECURE:-0}"
KUBECONFIG_DIR="${KUBECONFIG_DIR:-$HOME/.kube/rancher}"
USERNAME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rancher/username"
LOGIN_TTL_MS=3600000

CURL_OPTS=(-sS --max-time 30)
[[ "$RANCHER_INSECURE" == "1" ]] && CURL_OPTS+=(-k)

BOLD=$'\033[1m'; RED=$'\033[31m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; RESET=$'\033[0m'
[[ -t 1 ]] || { BOLD=""; RED=""; GREEN=""; DIM=""; RESET=""; }

die() { echo "${RED}erro:${RESET} $*" >&2; exit 1; }

usage() {
  cat <<EOF
uso: ${0##*/} [cluster ...]

Baixa os kubeconfigs do Rancher (${RANCHER_URL}) para ${KUBECONFIG_DIR}.
Sem argumentos, sincroniza todos os clusters ativos.

variáveis: RANCHER_URL (obrigatória), RANCHER_INSECURE=1, KUBECONFIG_DIR, RANCHER_USER, RANCHER_PASSWORD, RANCHER_REMEMBER=1
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

[[ -n "$RANCHER_URL" ]] || die "defina RANCHER_URL (a URL do seu Rancher)"

command -v jq >/dev/null || die "jq não encontrado"

TOKEN=""
TOKEN_ID=""
cleanup() {
  if [[ -n "$TOKEN_ID" ]]; then
    curl "${CURL_OPTS[@]}" -o /dev/null -X DELETE \
      -H @<(printf 'Authorization: Bearer %s\n' "$TOKEN") \
      "$RANCHER_URL/v3/tokens/$TOKEN_ID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

read_username() {
  local default_user=""
  [[ -n "${RANCHER_USER:-}" ]] && { echo "$RANCHER_USER"; return; }
  [[ -f "$USERNAME_FILE" ]] && default_user="$(<"$USERNAME_FILE")"
  local prompt="usuário do Rancher"
  [[ -n "$default_user" ]] && prompt+=" [$default_user]"
  local answer
  read -r -p "$prompt: " answer </dev/tty
  [[ -z "$answer" ]] && answer="$default_user"
  [[ -z "$answer" ]] && die "usuário não informado"
  mkdir -p "$(dirname "$USERNAME_FILE")"
  printf '%s' "$answer" > "$USERNAME_FILE"
  echo "$answer"
}

login() {
  local user="$1" password="$2" body response code
  body="$(RANCHER_LOGIN_PASSWORD="$password" jq -n --arg u "$user" --argjson ttl "$LOGIN_TTL_MS" \
    '{username: $u, password: env.RANCHER_LOGIN_PASSWORD, ttl: $ttl, responseType: "json"}')"
  response="$(printf '%s' "$body" | curl "${CURL_OPTS[@]}" -w '\n%{http_code}' -X POST \
    -H 'Content-Type: application/json' --data-binary @- \
    "$RANCHER_URL/v3-public/localProviders/local?action=login")" || die "não consegui falar com $RANCHER_URL"
  code="${response##*$'\n'}"
  response="${response%$'\n'*}"
  [[ "$code" == "201" || "$code" == "200" ]] || die "login falhou (HTTP $code): $(jq -r '.message // .code // empty' <<<"$response" 2>/dev/null)"
  TOKEN="$(jq -r '.token' <<<"$response")"
  TOKEN_ID="$(jq -r '.id' <<<"$response")"
  [[ -n "$TOKEN" && "$TOKEN" != "null" ]] || die "resposta de login sem token"
}

api() {
  local method="$1" path="$2"
  curl "${CURL_OPTS[@]}" -X "$method" \
    -H @<(printf 'Authorization: Bearer %s\n' "$TOKEN") \
    -H 'Content-Type: application/json' \
    "$RANCHER_URL$path"
}

slugify() {
  local s
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  s="${s//[^a-z0-9._-]/-}"
  s="${s##-}"; s="${s%%-}"
  printf '%s' "$s"
}

remember_password() {
  local account="$1@$RANCHER_URL" pass="$2"
  if command -v secret-tool >/dev/null; then
    printf '%s' "$pass" | secret-tool store --label="Rancher ($account)" service maestria-argocd account "$account" 2>/dev/null \
      && { echo "${DIM}senha guardada no chaveiro do sistema${RESET}"; return; }
  elif command -v security >/dev/null; then
    local esc="${pass//\\/\\\\}"
    esc="${esc//\"/\\\"}"
    printf 'add-generic-password -U -s maestria-argocd -a "%s" -w "%s"\n' "$account" "$esc" | security -i >/dev/null 2>&1 \
      && { echo "${DIM}senha guardada no chaveiro${RESET}"; return; }
  fi
  echo "${RED}não consegui guardar a senha no chaveiro${RESET} ${DIM}(no Linux: sudo apt install libsecret-tools)${RESET}" >&2
}

username="$(read_username)"
prompted=0
if [[ -n "${RANCHER_PASSWORD:-}" ]]; then
  password="$RANCHER_PASSWORD"
  unset RANCHER_PASSWORD
else
  prompted=1
  read -r -s -p "senha de $username: " password </dev/tty
  echo
fi
[[ -n "$password" ]] || die "senha vazia"

login "$username" "$password"
[[ "${RANCHER_REMEMBER:-0}" == "1" && "$prompted" == "1" ]] && remember_password "$username" "$password"
unset password

clusters_json="$(api GET '/v3/clusters?limit=-1')" || die "não consegui listar os clusters"
jq -e '.data' >/dev/null 2>&1 <<<"$clusters_json" || die "resposta inesperada de /v3/clusters: $(head -c 200 <<<"$clusters_json")"

clusters=()
while IFS= read -r linha; do
  [[ -n "$linha" ]] && clusters+=("$linha")
done < <(jq -r '.data[] | select(.state == "active") | "\(.id)\t\(.name)"' <<<"$clusters_json")
(( ${#clusters[@]} )) || die "nenhum cluster ativo encontrado"

if (( $# )); then
  wanted=("$@")
  filtered=()
  for entry in "${clusters[@]}"; do
    name="${entry#*$'\t'}"
    for w in "${wanted[@]}"; do
      [[ "$(slugify "$name")" == "$(slugify "$w")" ]] && filtered+=("$entry")
    done
  done
  (( ${#filtered[@]} )) || die "nenhum cluster bate com: $*"
  clusters=("${filtered[@]}")
fi

mkdir -p "$KUBECONFIG_DIR"
chmod 700 "$KUBECONFIG_DIR"

failures=0
echo
for entry in "${clusters[@]}"; do
  id="${entry%%$'\t'*}"
  name="${entry#*$'\t'}"
  slug="$(slugify "$name")"
  target="$KUBECONFIG_DIR/$slug.yaml"

  printf '  %-24s ' "$slug"
  if config="$(api POST "/v3/clusters/$id?action=generateKubeconfig")" \
     && kubeconfig="$(jq -er '.config' <<<"$config" 2>/dev/null)"; then
    tmp="$(mktemp "$target.XXXXXX")"
    printf '%s' "$kubeconfig" > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$target"
    printf '%s✓%s %s%s%s\n' "$GREEN" "$RESET" "$DIM" "$target" "$RESET"
  else
    printf '%s✗%s %s\n' "$RED" "$RESET" "$(jq -r '.message // empty' <<<"${config:-}" 2>/dev/null)"
    (( ++failures ))
  fi
done
echo

if (( failures )); then
  echo "${RED}$failures cluster(s) falharam.${RESET}" >&2
  exit 1
fi

echo "${BOLD}${#clusters[@]} kubeconfig(s) em $KUBECONFIG_DIR${RESET}"
}

main "$@"
