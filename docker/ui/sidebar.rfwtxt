// A aba da lateral do docker, montada pelo plugin com os widgets do Flutter:
// a Maestria só desenha. Os dados chegam em `data` (`data.rows`, `data.head`)
// e as cores do tema em `data.theme`. Todo clique vira `event "act"` com a
// ação em `a` (ou `action`, quando vem de um menu).

import core.widgets;
import maestria;

widget root = Column(
  crossAxisAlignment: "stretch",
  children: [
    Head(),
    Expanded(
      child: ListView(
        padding: [8.0, 0.0, 8.0, 16.0],
        children: [
          ...for row in data.rows:
            switch row.kind {
              "label": Label(text: row.title),
              "project": ProjectRow(row: row),
              "term": TermRow(row: row),
              default: ContainerRow(row: row),
            },
        ],
      ),
    ),
  ],
);

// O topo: "Containers", quantos no ar, e os botões.
widget Head = Padding(
  padding: [14.0, 12.0, 10.0, 8.0],
  child: Row(
    children: [
      Expanded(
        child: Column(
          crossAxisAlignment: "start",
          children: [
            Text(text: data.head.title, style: { fontSize: 13.5, fontWeight: "w700", color: data.theme.fg }),
            SizedBox(height: 2.0),
            Text(text: data.head.sub, maxLines: 1, overflow: "ellipsis", style: { fontSize: 11.5, color: data.theme.dim }),
          ],
        ),
      ),
      MenuButton(icon: "filter", tooltip: "filtrar e ordenar", menu: data.head.menu, onMenu: event "act" {}),
      IconButton(icon: "refresh", tooltip: "atualizar", onPressed: event "act" { a: "atualizar" }),
      IconButton(icon: "layers", tooltip: "imagens, volumes e disco", onPressed: event "act" { a: "janela" }),
    ],
  ),
);

widget Label = Padding(
  padding: [8.0, 16.0, 8.0, 6.0],
  child: Text(text: args.text, style: { fontSize: 11.5, fontWeight: "w600", color: data.theme.faint }),
);

// O cubo (ou a pilha) com a bolinha do estado no canto.
widget Avatar = SizedBox(
  width: 26.0,
  height: 26.0,
  child: Stack(
    children: [
      Opacity(
        opacity: switch args.dim { true: 0.72, default: 1.0 },
        child: Svg(svg: args.svg, width: 26.0, height: 26.0),
      ),
      switch args.dot {
        "none": SizedBox(),
        default: Positioned(
          end: 0.0,
          bottom: 0.0,
          child: Container(
            width: 9.0,
            height: 9.0,
            decoration: {
              type: "box",
              shape: "circle",
              color: switch args.dot {
                "green": data.theme.green,
                "red": data.theme.red,
                "yellow": data.theme.yellow,
                default: data.theme.faint,
              },
              border: [{ color: switch args.selected { true: data.theme.accent, default: data.theme.sidebar }, width: 2.0 }],
            },
          ),
        ),
      },
    ],
  ),
);

// As cores de uma linha: acesa (a janela dela está aberta), apagada (parada) ou normal.
widget TitleText = Text(
  text: args.text,
  maxLines: 1,
  overflow: "ellipsis",
  style: {
    fontSize: 13.0,
    fontWeight: switch args.strong { true: "w600", default: "w400" },
    color: switch args.selected { true: data.theme.onAccent, default: switch args.dim { true: data.theme.dim, default: data.theme.fg } },
  },
);

widget SubText = Text(
  text: args.text,
  maxLines: 1,
  overflow: "ellipsis",
  style: { fontSize: 11.0, color: switch args.selected { true: data.theme.onAccent, default: data.theme.faint } },
);

widget Actions = Row(
  mainAxisSize: "min",
  children: [
    ...for act in args.row.actions:
      IconButton(
        icon: act.icon,
        tooltip: act.tooltip,
        onPressed: event "act" { a: act.action },
        color: switch args.row.selected { true: data.theme.onAccent, default: switch args.row.dim { true: data.theme.faint, default: data.theme.dim } },
      ),
  ],
);

widget Pill = switch args.text {
  "": SizedBox(),
  default: Container(
    margin: [6.0, 0.0, 4.0, 0.0],
    padding: [7.0, 1.0, 7.0, 1.0],
    decoration: { type: "box", color: data.theme.active, borderRadius: [{ x: 10.0 }] },
    child: Text(text: args.text, style: { fontSize: 10.5, color: data.theme.yellow }),
  ),
};

widget ContainerRow = Pressable(
  radius: 8.0,
  color: switch args.row.selected { true: data.theme.accent, default: 0x00000000 },
  hoverColor: switch args.row.selected { true: data.theme.accent, default: data.theme.hover },
  onTap: event "act" { a: args.row.action },
  menu: args.row.menu,
  onMenu: event "act" {},
  child: SizedBox(
    height: 44.0,
    child: Padding(
      padding: switch args.row.indent { 1: [32.0, 0.0, 4.0, 0.0], default: [10.0, 0.0, 4.0, 0.0] },
      child: Row(
        children: [
          Avatar(svg: args.row.svg, dot: args.row.dot, dim: args.row.dim, selected: args.row.selected),
          SizedBox(width: 10.0),
          Expanded(
            child: Column(
              mainAxisAlignment: "center",
              crossAxisAlignment: "start",
              children: [
                TitleText(text: args.row.title, strong: false, dim: args.row.dim, selected: args.row.selected),
                SizedBox(height: 1.0),
                SubText(text: args.row.sub, selected: args.row.selected),
              ],
            ),
          ),
          Pill(text: args.row.pill),
          Actions(row: args.row),
        ],
      ),
    ),
  ),
);

widget ProjectRow = Pressable(
  radius: 8.0,
  color: switch args.row.selected { true: data.theme.accent, default: 0x00000000 },
  hoverColor: switch args.row.selected { true: data.theme.accent, default: data.theme.hover },
  onTap: event "act" { a: args.row.action },
  menu: args.row.menu,
  onMenu: event "act" {},
  child: SizedBox(
    height: 44.0,
    child: Row(
      children: [
        Pressable(
          onTap: event "act" { a: args.row.toggle },
          padding: [2.0, 8.0, 0.0, 8.0],
          child: Rotation(
            turns: switch args.row.open { true: 0.25, default: 0.0 },
            duration: 140,
            child: Glyph(icon: "chevron", size: 18.0, color: switch args.row.selected { true: data.theme.onAccent, default: data.theme.faint }),
          ),
        ),
        SizedBox(width: 2.0),
        Avatar(svg: args.row.svg, dot: args.row.dot, dim: args.row.dim, selected: args.row.selected),
        SizedBox(width: 10.0),
        Expanded(
          child: Column(
            mainAxisAlignment: "center",
            crossAxisAlignment: "start",
            children: [
              TitleText(text: args.row.title, strong: args.row.strong, dim: args.row.dim, selected: args.row.selected),
              switch args.row.sub {
                "": SizedBox(),
                default: SubText(text: args.row.sub, selected: args.row.selected),
              },
            ],
          ),
        ),
        Pill(text: args.row.pill),
        Actions(row: args.row),
      ],
    ),
  ),
);

// Um terminal do plugin num painel: clicar vai pra ele, o × fecha.
widget TermRow = Pressable(
  radius: 8.0,
  hoverColor: data.theme.hover,
  onTap: event "act" { a: args.row.action },
  child: SizedBox(
    height: 40.0,
    child: Padding(
      padding: [10.0, 0.0, 4.0, 0.0],
      child: Row(
        children: [
          SizedBox(width: 26.0, child: Center(child: Glyph(icon: "terminal", size: 17.0, color: switch args.row.dot { "red": data.theme.red, default: data.theme.green }))),
          SizedBox(width: 10.0),
          Expanded(
            child: Column(
              mainAxisAlignment: "center",
              crossAxisAlignment: "start",
              children: [
                TitleText(text: args.row.title, strong: false, dim: false, selected: false),
                SubText(text: args.row.sub, selected: false),
              ],
            ),
          ),
          Actions(row: args.row),
        ],
      ),
    ),
  ),
);
