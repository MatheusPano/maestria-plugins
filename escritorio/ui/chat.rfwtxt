                Text(text: data.voce.room, style: { fontSize: 11.5, color: data.theme.faint }),
                SizedBox(height: 12.0),
                Text(text: "seu nome", style: { fontSize: 11.0, fontWeight: "w600", color: data.theme.dim }),
                SizedBox(height: 4.0),
                TextInput(
                  id: "voce-nome",
                  value: data.voce.name,
                  placeholder: "como te chamam no escritório?",
                  sendIcon: "check",
                  onSubmit: event "act" { a: "voce-nome" },
                ),
              ],
            ),
          ),
        ],
      ),
    ),
    Container(height: 1.0, color: data.theme.border),
    Expanded(
      child: SingleChildScrollView(
        primary: false, // cada área rolável com o seu controlador
        padding: [18.0, 10.0, 18.0, 10.0],
        child: Column(
          crossAxisAlignment: "stretch",
          children: [
            ...for g in data.voce.parts:
              Part(g: g),
            Padding(
              padding: [0.0, 8.0, 0.0, 4.0],
              child: Text(text: "acessório", style: { fontSize: 11.0, fontWeight: "w600", color: data.theme.dim }),
            ),
            Wrap(
              spacing: 6.0,
              runSpacing: 6.0,
              children: [
                ...for x in data.voce.accessories:
                  Chip(c: x),
              ],
            ),
          ],
        ),
      ),
    ),
    Container(height: 1.0, color: data.theme.border),
    Padding(
      padding: [14.0, 10.0, 14.0, 12.0],
      child: Row(
        children: [
          Pressable(
            radius: 8.0,
            hoverColor: data.theme.hover,
            padding: [10.0, 6.0, 10.0, 6.0],
            onTap: event "act" { a: "voce-padrao" },
            child: Text(text: "voltar ao padrão", style: { fontSize: 12.0, color: data.theme.dim }),
          ),
          Spacer(),
          Pressable(
            radius: 8.0,
            color: data.theme.accent,
            padding: [14.0, 6.0, 14.0, 7.0],
            onTap: event "act" { a: "voce-pronto" },
            child: Text(text: "pronto", style: { fontSize: 12.5, fontWeight: "w600", color: data.theme.onAccent }),
          ),
        ],
      ),
    ),
  ],
);

// Você andando em direção a quem olha, com a roupa da vez.
widget Preview = switch data.sprites {
  true: Sprite(
    sheet: args.v.sheet,
    columns: 4,
    rows: args.v.rows,
    row: args.v.row,
    frames: 4,
    fps: 6.0,
    width: 64.0,
    height: 96.0,
  ),
  default: Glyph(icon: "user", size: 40.0, color: data.theme.accent),
};

// Uma parte (o cabelo, a camisa…): o nome e as bolinhas de cor.
widget Part = Padding(
  padding: [0.0, 6.0, 0.0, 6.0],
  child: Column(
    crossAxisAlignment: "start",
    children: [
      Text(text: args.g.label, style: { fontSize: 11.0, fontWeight: "w600", color: data.theme.dim }),
      SizedBox(height: 6.0),
      Wrap(
        spacing: 6.0,
        runSpacing: 6.0,
        children: [
          ...for o in args.g.options:
            Swatch(o: o),
        ],
      ),
    ],
  ),
);

// Uma cor: a escolhida tem o anel na cor de destaque.
widget Swatch = Pressable(
  radius: 15.0,
  onTap: event "act" { a: args.o.action },
  child: Container(
    width: 28.0,
    height: 28.0,
    padding: [3.0, 3.0, 3.0, 3.0],
    decoration: {
      type: "box",
      shape: "circle",
      border: [{ color: switch args.o.on { true: data.theme.accent, default: 0x00000000 }, width: 2.0 }],
    },
    child: Container(
      decoration: { type: "box", color: args.o.color, shape: "circle", border: [{ color: 0x55000000, width: 1.0 }] },
    ),
  ),
);

// Um acessório: o escolhido aceso.
widget Chip = Pressable(
  radius: 14.0,
  color: switch args.c.on { true: data.theme.accent, default: data.theme.active },
  hoverColor: data.theme.hover,
  padding: [12.0, 5.0, 12.0, 6.0],
  onTap: event "act" { a: args.c.action },
  child: Text(
    text: args.c.label,
    style: { fontSize: 12.0, color: switch args.c.on { true: data.theme.onAccent, default: data.theme.fg } },
  ),
);

// --- os recados dos ajudantes --------------------------------------------------------
//
// O que cada ajudante respondeu, do mais novo pro mais velho: o tipo dele (o
// Explore, o Plan), o que foi fazer, a hora e a resposta em markdown.

widget recados = Column(
  crossAxisAlignment: "stretch",
  children: [
    Padding(
      padding: [18.0, 16.0, 18.0, 10.0],
      child: Column(
        crossAxisAlignment: "start",
        children: [
          Text(text: ["recados pra ", data.recados.name], style: { fontSize: 16.0, fontWeight: "w700", color: data.theme.fg }),
          SizedBox(height: 2.0),
          Text(text: data.recados.sub, style: { fontSize: 11.5, color: data.theme.faint }),
        ],
      ),
    ),
    Container(height: 1.0, color: data.theme.border),
    Expanded(
      child: Conversation(
        child: SingleChildScrollView(
          primary: false, // cada área rolável com o seu controlador
          padding: [16.0, 12.0, 16.0, 12.0],
          child: Lines(
            child: Column(
              crossAxisAlignment: "stretch",
              children: [
                ...for n in data.recados.notes:
                  Recado(n: n),
              ],
            ),
          ),
        ),
      ),
    ),
  ],
);

widget Recado = Padding(
  padding: [0.0, 0.0, 0.0, 12.0],
  child: Container(
    padding: [12.0, 9.0, 12.0, 10.0],
    decoration: {
      type: "box",
      color: data.theme.sidebar,
      border: [{ color: switch args.n.fresh { true: 0xFF4E8AD1, default: data.theme.border }, width: switch args.n.fresh { true: 1.5, default: 1.0 } }],
      borderRadius: [{ x: 12.0 }],
    },
    child: Column(
      crossAxisAlignment: "stretch",
      children: [
        Row(
          children: [
            Glyph(icon: "file", size: 14.0, color: 0xFF4E8AD1),
            SizedBox(width: 6.0),
            switch args.n.hasType {
              true: Container(
                margin: [0.0, 0.0, 6.0, 0.0],
                padding: [6.0, 1.0, 6.0, 2.0],
                decoration: { type: "box", color: data.theme.active, borderRadius: [{ x: 8.0 }] },
                child: Text(text: args.n.type, style: { fontSize: 10.5, fontWeight: "w700", color: data.theme.accent }),
              ),
              default: SizedBox(),
            },
            Expanded(child: Text(text: args.n.what, maxLines: 1, overflow: "ellipsis", style: { fontSize: 12.5, fontWeight: "w700", color: data.theme.fg })),
            Text(text: args.n.when, style: { fontSize: 11.0, color: data.theme.faint }),
          ],
        ),
        SizedBox(height: 6.0),
        Reply(text: args.n.text),
      ],
    ),
  ),
);

// --- mandar pra vários ---------------------------------------------------------------
//
// Quem vai receber (o x tira da lista), os atalhos e o campo. Quem espera uma
// permissão ou uma resposta sua aparece apagado: pra ele não vai.

widget grupo = Column(
  crossAxisAlignment: "stretch",
  children: [
    Padding(
      padding: [18.0, 16.0, 18.0, 8.0],
      child: Column(
        crossAxisAlignment: "start",
        children: [
          Text(text: data.grupo.title, style: { fontSize: 16.0, fontWeight: "w700", color: data.theme.fg }),
          SizedBox(height: 2.0),
          Text(text: "a mesma mensagem vai pro terminal de cada um; quem dorme acorda e lê.", style: { fontSize: 11.5, color: data.theme.faint }),
        ],
      ),
    ),
    Expanded(
      child: SingleChildScrollView(
        primary: false, // cada área rolável com o seu controlador
        padding: [16.0, 4.0, 16.0, 4.0],
        child: Column(
          crossAxisAlignment: "stretch",
          children: [
            Wrap(
              spacing: 6.0,
              runSpacing: 6.0,
              children: [
                ...for w in data.grupo.names:
                  Opacity(
                    opacity: switch w.waiting { true: 0.45, default: 1.0 },
                    child: Container(
                      padding: [6.0, 3.0, 2.0, 3.0],
                      decoration: { type: "box", color: data.theme.active, borderRadius: [{ x: 14.0 }] },
                      child: Row(
                        mainAxisSize: "min",
                        children: [
                          Mini(w: w),
                          SizedBox(width: 5.0),
                          Text(text: w.name, style: { fontSize: 12.0, color: data.theme.fg }),
                          IconButton(icon: "close", tooltip: "tirar da lista", onPressed: event "act" { a: "grupo-tirar", tab: w.tabId }),
                        ],
                      ),
                    ),
                  ),
              ],
            ),
            SizedBox(height: 12.0),
            Text(text: "atalhos", style: { fontSize: 11.0, fontWeight: "w600", color: data.theme.dim }),
            SizedBox(height: 6.0),
            Wrap(
              spacing: 6.0,
              runSpacing: 6.0,
              children: [
                ...for p in data.grupo.presets:
                  Pressable(
                    radius: 14.0,
                    color: data.theme.active,
                    hoverColor: data.theme.hover,
                    padding: [11.0, 5.0, 11.0, 6.0],
                    onTap: event "act" { a: "grupo-preset", text: p.text },
                    child: Text(text: p.text, style: { fontSize: 12.0, color: data.theme.fg, fontFamily: data.theme.mono }),
                  ),
              ],
            ),
          ],
        ),
      ),
    ),
    Problem(p: data.grupo.problem),
    Padding(
      padding: [14.0, 6.0, 14.0, 14.0],
      child: TextInput(
        id: "grupo",
        placeholder: "a mensagem pra todos…",
        multiline: true,
        maxLines: 5,
        autofocus: true,
        clear: data.grupo.sent,
        sendIcon: "send",
        onSubmit: event "act" { a: "grupo-enviar" },
      ),
    ),
  ],
);

// O bonequinho de cada um, pequeno, no chip.
widget Mini = switch data.sprites {
  true: Sprite(sheet: args.w.sheet, columns: 4, rows: 13, row: 0, frames: 1, fps: 0.0, paused: true, width: 12.0, height: 18.0),
  default: Glyph(icon: "user", size: 14.0, color: data.theme.accent),
};

// --- a daily ---------------------------------------------------------------------------
//
// A daily da vez (ou o "bom dia"): sem resumo ainda, o que ficou pendente na
// última; com resumo, um cartão por trabalho -- o que fez, o curioso (💡) e o
// que falta --, o texto pronto pra falar, com o copiar, e no fim o pendente da
// anterior (riscado quando foi resolvido). Enquanto o resumo é escrito, o
// aviso do que está acontecendo. Abrir só mostra (a da vez, ou uma que já foi
// pelo relógio); o "fazer a daily" é que leva todo mundo pra sala de reunião,
// e o ↻ escreve um resumo novo sem ela.

widget daily = Column(
  crossAxisAlignment: "stretch",
  children: [
    Padding(
      padding: [18.0, 16.0, 12.0, 10.0],
      child: Row(
        children: [
          Container(
            width: 34.0,
            height: 34.0,
            decoration: { type: "box", color: data.theme.active, borderRadius: [{ x: 9.0 }] },
            child: Center(child: Glyph(icon: "calendar", size: 18.0, color: data.theme.accent)),
          ),
          SizedBox(width: 12.0),
          Expanded(
            child: Column(
              crossAxisAlignment: "start",
              children: [
                Text(text: data.daily.title, style: { fontSize: 16.0, fontWeight: "w700", color: data.theme.fg }),
                SizedBox(height: 2.0),
                Text(text: data.daily.sub, maxLines: 1, overflow: "ellipsis", style: { fontSize: 11.5, color: data.theme.faint }),
              ],
            ),
          ),
          // As dailies que já foram: só pra ver, sem ler nem juntar nada.
          switch data.daily.hasHistory {
            true: MenuButton(icon: "clock", tooltip: "ver outra daily", menu: data.daily.history, onMenu: event "act" {}),
            default: SizedBox(),
          },
          switch data.daily.loading {
            true: SizedBox(),
            default: IconButton(icon: "refresh", tooltip: "novo resumo, sem reunião: lê as conversas do período de novo", onPressed: event "act" { a: "daily-refazer" }),
          },
          SizedBox(width: 6.0),
          // O "fazer a daily": a janela fecha e eles contam na sala de reunião.
          switch data.daily.meeting {
            true: Pressable(
              radius: 8.0,
              color: data.theme.active,
              hoverColor: data.theme.hover,
              padding: [11.0, 6.0, 12.0, 7.0],
              onTap: event "act" { a: "daily-encerrar" },
              child: Row(
                mainAxisSize: "min",
                children: [
                  Glyph(icon: "stop", size: 13.0, color: data.theme.fg),
                  SizedBox(width: 5.0),
                  Text(text: "encerrar a reunião", style: { fontSize: 12.0, fontWeight: "w600", color: data.theme.fg }),
                ],
              ),
            ),
            default: Pressable(
              radius: 8.0,
              color: data.theme.accent,
              padding: [11.0, 6.0, 12.0, 7.0],
              onTap: event "act" { a: "daily-fazer" },
              child: Row(
                mainAxisSize: "min",
                children: [
                  Glyph(icon: "play", size: 13.0, color: data.theme.onAccent),
                  SizedBox(width: 5.0),
                  Text(text: "fazer a daily", style: { fontSize: 12.0, fontWeight: "w600", color: data.theme.onAccent }),
                ],
              ),
            ),
          },
          SizedBox(width: 4.0),
          IconButton(icon: "close", tooltip: "fechar", onPressed: event "act" { a: "daily-fechar" }),
        ],
      ),
    ),
    Container(height: 1.0, color: data.theme.border),
    Expanded(
      child: Conversation(
        child: SingleChildScrollView(
          primary: false, // cada área rolável com o seu controlador
          padding: [16.0, 12.0, 16.0, 12.0],
          child: Lines(
            child: Column(
              crossAxisAlignment: "stretch",
              children: [
                DailyNote(d: data.daily),
                Problem(p: data.daily.problem),
                DailyHint(h: data.daily.empty),
                DailyHint(h: data.daily.old),
                Before(b: data.daily.pendingTop),
                ...for it in data.daily.items:
                  DailyItem(it: it),
                DailyText(d: data.daily),
                Before(b: data.daily.pendingBottom),
              ],
            ),
          ),
        ),
      ),
    ),
  ],
);

// O que está acontecendo enquanto o resumo é feito.
widget DailyNote = switch args.d.loading {
  true: Padding(
    padding: [0.0, 4.0, 0.0, 12.0],
    child: Row(
      children: [
        Glyph(icon: "clock", size: 15.0, color: data.theme.accent),
        SizedBox(width: 10.0),
        Expanded(child: Text(text: args.d.note, style: { fontSize: 12.5, color: data.theme.dim })),
      ],
    ),
  ),
  default: SizedBox(),
};

// Um aviso discreto: nada pra mostrar ainda (o que cada botão faz), ou uma
// daily que já foi na tela (com o "ver a próxima").
widget DailyHint = switch args.h.on {
  true: Container(
    margin: [0.0, 0.0, 0.0, 12.0],
    padding: [12.0, 9.0, 12.0, 10.0],
    decoration: { type: "box", border: [{ color: data.theme.border, width: 1.0 }], borderRadius: [{ x: 12.0 }] },
    child: Row(
      children: [
        Glyph(icon: "info", size: 14.0, color: data.theme.dim),
        SizedBox(width: 8.0),
        Expanded(child: Text(text: args.h.text, style: { fontSize: 12.0, color: data.theme.dim, height: 1.4 })),
        switch args.h.go.on {
          true: Padding(
            padding: [10.0, 0.0, 0.0, 0.0],
            child: Pressable(
              radius: 8.0,
              color: data.theme.active,
              hoverColor: data.theme.hover,
              padding: [10.0, 4.0, 11.0, 5.0],
              onTap: event "act" { a: args.h.go.action },
              child: Text(text: args.h.go.label, style: { fontSize: 11.5, fontWeight: "w600", color: data.theme.fg }),
            ),
          ),
          default: SizedBox(),
        },
      ],
    ),
  ),
  default: SizedBox(),
};

// O que ficou pendente na daily anterior: o nome do trabalho e o que falta,
// em duas linhas no máximo; riscado (e no fim) o que foi resolvido. Os
// primeiros só, até o "mais N"; o "abrir" mostra aquela daily inteira.
widget Before = switch args.b.on {
  true: Container(
    margin: [0.0, 0.0, 0.0, 12.0],
    padding: [12.0, 9.0, 12.0, 10.0],
    decoration: { type: "box", color: data.theme.active, borderRadius: [{ x: 12.0 }] },
    child: Column(
      crossAxisAlignment: "stretch",
      children: [
        Row(
          children: [
            Glyph(icon: "clock", size: 13.0, color: data.theme.dim),
            SizedBox(width: 6.0),
            Expanded(child: Text(text: args.b.title, maxLines: 1, overflow: "ellipsis", style: { fontSize: 11.5, fontWeight: "w700", color: data.theme.dim })),
            Pressable(
              radius: 6.0,
              hoverColor: data.theme.hover,
              padding: [7.0, 2.0, 7.0, 3.0],
              onTap: event "act" { a: args.b.open },
              child: Text(text: "abrir", style: { fontSize: 11.5, color: data.theme.accent }),
            ),
          ],
        ),
        SizedBox(height: 4.0),
        ...for p in args.b.items:
          Padding(
            padding: [0.0, 5.0, 0.0, 0.0],
            child: Row(
              crossAxisAlignment: "start",
              children: [
                SizedBox(
                  width: 16.0,
                  child: Text(
                    text: switch p.done { true: "✓", default: "·" },
                    style: { fontSize: 12.0, height: 1.35, color: switch p.done { true: data.theme.faint, default: data.theme.dim } },
                  ),
                ),
                Expanded(
                  child: Column(
                    crossAxisAlignment: "start",
                    children: [
                      Text(
                        text: p.nome,
                        maxLines: 1,
                        overflow: "ellipsis",
                        style: {
                          fontSize: 12.0,
                          fontWeight: "w600",
                          height: 1.35,
                          color: switch p.done { true: data.theme.faint, default: data.theme.fg },
                          decoration: switch p.done { true: "lineThrough", default: "none" },
                        },
                      ),
                      Text(
                        text: p.text,
                        maxLines: 2,
                        overflow: "ellipsis",
                        style: {
                          fontSize: 12.0,
                          height: 1.35,
                          color: switch p.done { true: data.theme.faint, default: data.theme.dim },
                          decoration: switch p.done { true: "lineThrough", default: "none" },
                        },
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
        switch args.b.more.on {
          true: Padding(
            padding: [10.0, 6.0, 0.0, 0.0],
            child: Row(
              children: [
                Pressable(
                  radius: 6.0,
                  hoverColor: data.theme.hover,
                  padding: [6.0, 2.0, 6.0, 3.0],
                  onTap: event "act" { a: "daily-pendentes" },
                  child: Text(text: args.b.more.label, style: { fontSize: 11.5, color: data.theme.accent }),
                ),
              ],
            ),
          ),
          default: SizedBox(),
        },
      ],
    ),
  ),
  default: SizedBox(),
};

// Um trabalho: quem fez (o bonequinho, quando a conversa está aberta), onde,
// o que fez, o curioso e o que falta; e o comentar na tarefa do Wiboor.
widget DailyItem = Padding(
  padding: [0.0, 0.0, 0.0, 10.0],
  child: Container(
    padding: [12.0, 10.0, 12.0, 11.0],
    decoration: { type: "box", color: data.theme.sidebar, border: [{ color: data.theme.border, width: 1.0 }], borderRadius: [{ x: 12.0 }] },
    child: Column(
      crossAxisAlignment: "stretch",
      children: [
        Row(
          children: [
            switch args.it.hasSheet {
              true: Padding(
                padding: [0.0, 0.0, 8.0, 0.0],
                child: Sprite(sheet: args.it.sheet, columns: 4, rows: 13, row: 0, frames: 1, fps: 0.0, paused: true, width: 12.0, height: 18.0),
              ),
              default: SizedBox(),
            },
            Expanded(
              child: Column(
                crossAxisAlignment: "start",
                children: [
                  Text(text: args.it.nome, style: { fontSize: 13.0, fontWeight: "w700", color: data.theme.fg }),
                  Text(text: args.it.where, maxLines: 1, overflow: "ellipsis", style: { fontSize: 11.0, color: data.theme.faint }),
                ],
              ),
            ),
            switch args.it.wiboor.on {
              true: Pressable(
                radius: 8.0,
                color: data.theme.active,
                hoverColor: data.theme.hover,
                padding: [9.0, 4.0, 10.0, 5.0],
                onTap: event "act" { a: "daily-wiboor", i: args.it.i },
                child: Row(
                  mainAxisSize: "min",
                  children: [
                    Glyph(icon: "chat", size: 12.0, color: data.theme.dim),
                    SizedBox(width: 4.0),
                    Text(text: args.it.wiboor.label, style: { fontSize: 11.0, color: data.theme.fg }),
                  ],
                ),
              ),
              default: SizedBox(),
            },
          ],
        ),
        SizedBox(height: 6.0),
        Text(text: args.it.fiz, style: { fontSize: 12.5, color: data.theme.fg, height: 1.4 }),
        switch args.it.hasCurioso {
          true: Padding(
            padding: [0.0, 6.0, 0.0, 0.0],
            child: Text(text: ["💡 ", args.it.curioso], style: { fontSize: 12.0, color: data.theme.dim, height: 1.4 }),
          ),
          default: SizedBox(),
        },
        switch args.it.hasPendente {
          true: Padding(
            padding: [0.0, 6.0, 0.0, 0.0],
            child: Text(text: ["⏳ falta: ", args.it.pendente], style: { fontSize: 12.0, color: 0xFFD08A2E, height: 1.4 }),
          ),
          default: SizedBox(),
        },
      ],
    ),
  ),
);

// O texto pronto pra falar na daily, com o copiar.
widget DailyText = switch args.d.hasText {
  true: Container(
    margin: [0.0, 6.0, 0.0, 0.0],
    padding: [12.0, 10.0, 12.0, 12.0],
    decoration: { type: "box", color: data.theme.active, borderRadius: [{ x: 12.0 }], border: [{ color: data.theme.accent, width: 1.0 }] },
    child: Column(
      crossAxisAlignment: "stretch",
      children: [
        Row(
          children: [
            Expanded(child: Text(text: "pra falar na daily", style: { fontSize: 11.0, fontWeight: "w700", color: data.theme.accent })),
            Pressable(
              radius: 8.0,
              color: data.theme.accent,
              padding: [10.0, 4.0, 11.0, 5.0],
              onTap: event "act" { a: "daily-copiar" },
              child: Row(
                mainAxisSize: "min",
                children: [
                  Glyph(icon: "copy", size: 12.0, color: data.theme.onAccent),
                  SizedBox(width: 4.0),
                  Text(text: "copiar", style: { fontSize: 11.5, fontWeight: "w600", color: data.theme.onAccent }),
                ],
              ),
            ),
          ],
        ),
        SizedBox(height: 6.0),
        Reply(text: args.d.text),
      ],
    ),
  ),
  default: SizedBox(),
};
